{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI General Courseware Production R36 Stage Artifact Map",
  "type": "object",
  "required": ["lesson_id", "course_info", "teacher_final"],
  "properties": {
    "lesson_id": {"type": "string", "pattern": "^lesson[0-9]{3,}$"},
    "course_info": {
      "type": "object",
      "required": ["packageName", "unitName", "lessonNumber", "courseName", "courseIntroduction", "knowledgePoints"],
      "properties": {
        "packageName": {"type": "string", "minLength": 1},
        "unitName": {"type": "string", "minLength": 1},
        "lessonNumber": {"type": "integer", "minimum": 1},
        "courseName": {"type": "string", "minLength": 1},
        "courseIntroduction": {"type": "string", "minLength": 1},
        "knowledgePoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "teacher_final": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}
  },
  "$comment": "This quick schema does not replace the complete S1-S6 contract or bundled validators."
}
