# RunS 页面数据编排配置
# 用法：cp .env.example .env 后填写 TOKEN。.env 已被 .gitignore 忽略，不会提交。
# 优先级：命令行参数 > 环境变量 > .env > 默认值
# 查找顺序：$XRUNS_ENV_FILE > ./.env > <技能目录>/.env > <仓库根>/.env

# 接口网关（脚本会自动补 /api/）
XRUNS_COURSEWARE_BASE_URL=https://api.dev.xruns.cn/api/

# 智课端站点：登录取 token 的地方，也用来拼课件预览链接
XRUNS_COURSEWARE_WEB_URL=https://web.dev.xruns.cn/

# 必填。获取方式：浏览器打开上面的站点登录，
# DevTools → Application → Local Storage 复制 access token，
# 或 Network 面板任一请求的 Authorization 头（去掉 Bearer 前缀）。
XRUNS_COURSEWARE_TOKEN=

# 可选。没有 token 时脚本用账号密码登录换取。
# XRUNS_COURSEWARE_USERNAME=
# XRUNS_COURSEWARE_PASSWORD=
